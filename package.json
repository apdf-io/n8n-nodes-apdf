{
	"name": "@apdf/n8n-nodes-apdf",
	"version": "0.1.4",
	"description": "n8n node for Apdf — PDF tracking links, reader analytics and PDF processing",
	"license": "MIT",
	"homepage": "https://apdf.io",
	"keywords": [
		"n8n-community-node-package",
		"apdf",
		"pdf",
		"document-tracking",
		"reader-analytics"
	],
	"author": {
		"name": "Apdf",
		"email": "email@apdf.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/apdf-io/n8n-nodes-apdf.git"
	},
	"bugs": {
		"url": "https://github.com/apdf-io/n8n-nodes-apdf/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ApdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Apdf/Apdf.node.js",
			"dist/nodes/Apdf/ApdfTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"n8n-core": "^2.16.1",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
